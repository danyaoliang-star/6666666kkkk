<key>NSLocalNetworkUsageDescription</key><string>开发调试时连接你在局域网中部署的家和健康管理系统。</string>
<key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict></plist>
